---
/**
 * The colour-scheme control, replacing Starlight's light and dark select.
 *
 * One button that steps through the cycle defined in ThemeProvider.astro. A
 * select would need names for three steps whose difference is easier to see
 * than to read, so the control shows one glyph for the current step and
 * changes on click.
 *
 * The glyph is decorative. The step's name reaches a screen reader through the
 * button's accessible name and a pointer through the tooltip, both written by
 * the script from window.dexView.describe().
 *
 * Starlight renders this component twice, in the header and in the mobile
 * menu, so the script wires every copy and updates every copy on a click.
 */
---

<button class="dex-view" type="button" aria-label="Colour scheme">
  <span class="dex-view__glyph" aria-hidden="true">☁︎</span>
</button>

<script is:inline>
  ;(() => {
    const buttons = () => document.querySelectorAll('button.dex-view')

    const sync = (button) => {
      const step = window.dexView.describe()
      button.querySelector('.dex-view__glyph').textContent = step.glyph
      button.dataset.scheme = step.name.toLowerCase()
      const name = 'Colour scheme: ' + step.name + '. Change it.'
      button.setAttribute('aria-label', name)
      button.title = name
    }

    buttons().forEach((button) => {
      sync(button)
      if (button.dataset.wired) return
      button.dataset.wired = 'yes'
      button.addEventListener('click', () => {
        window.dexView.advance()
        buttons().forEach(sync)
      })
    })
  })()
</script>

<style>
  .dex-view {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  .dex-view:hover,
  .dex-view:focus-visible {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }

  /* The glyph inherits the button's colour, so it follows the palette. The
   * text presentations of these three characters are small against the
   * surrounding interface text, so the size is set here. */
  .dex-view__glyph {
    font-size: 1.3rem;
    line-height: 1;
  }

  /* The moon and the sun fill their em box; U+2601 draws in the lower half of
   * its own, so on the shared centre it reads as sitting low. */
  .dex-view[data-scheme='blue'] .dex-view__glyph {
    transform: translateY(-0.1em);
  }
</style>
