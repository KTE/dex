#!/bin/sh
# Create the two things dexd.service requires but cannot create itself:
# the unprivileged `dex` user it runs as, and the asset directory it reads.
#
# Both were manual steps in the pre-package install recipe, which is precisely
# why they belong here: an unattended gallery device should not depend on
# whether whoever imaged the SD card remembered a chmod.
set -e

case "$1" in
configure)
  # A system user with no login, no home, and no password. It needs `video`
  # and `render` only to open /dev/dri -- everything else is denied by the
  # unit's own sandboxing (ProtectSystem=strict, ProtectHome, NoNewPrivileges).
  if ! getent passwd dex >/dev/null; then
    adduser --system --group --home /nonexistent --no-create-home \
      --shell /usr/sbin/nologin dex
  fi
  # Idempotent: adduser to a group the user is already in is a no-op, so this
  # also repairs an install where the groups were dropped.
  for g in video render; do
    if getent group "$g" >/dev/null; then
      adduser dex "$g" >/dev/null || true
    fi
  done

  # The asset directory. The package deliberately ships NO asset: the video and
  # its sidecar are content, they change per installation, and baking one into
  # the package would mean rebuilding the software to change the artwork.
  # Root-owned and world-readable — the unit mounts it ReadOnlyPaths anyway,
  # and the player only ever reads.
  mkdir -p /opt/dex
  chmod 0755 /opt/dex

  # Three files make a player: the video, its sidecar and the exhibit config,
  # all in /opt/dex. The package ships none of them.
  if [ ! -e /opt/dex/exhibit.yaml ] && [ ! -e /opt/dex/exhibit.json ]; then
    echo "dexd: installed. To play, put three files in /opt/dex and start the unit:" >&2
    echo "    the video (for example artwork.265), its sidecar (artwork.265.json)," >&2
    echo "    and exhibit.yaml naming the video and the display mode:" >&2
    echo "        asset: artwork.265" >&2
    echo "        display_mode: auto" >&2
    echo "    sudo systemctl start dexd" >&2
    echo "  dexd refuses to start without the sidecar or the config, rather than guess." >&2
  fi

  # A config left over from a version that read /etc/dex. It is not read any
  # more; say so once, at install time, instead of letting the player refuse at
  # the next power cycle with nobody watching.
  if [ -e /etc/dex/exhibit.yaml ] || [ -e /etc/dex/exhibit.json ]; then
    echo "dexd: NOTE: a config exists under /etc/dex, which dexd no longer reads." >&2
    echo "  Move it next to the video: sudo mv /etc/dex/exhibit.* /opt/dex/ && sudo rmdir /etc/dex" >&2
  fi

  # A systemd drop-in that still passes --mode. LOUD, non-fatal, because the
  # package must not delete an admin-created /etc file itself -- and it need
  # not: if the drop-in DISAGREES with the exhibit config, main.rs's own
  # --mode cross-check refuses to start and names both values, so nothing can
  # silently win. This warning exists for the case that still WOULD start:
  # a drop-in that happens to agree, or one that has gone stale in some other
  # way -- purely so the leftover gets noticed and removed rather than
  # outliving its reason.
  dropin_dir=/etc/systemd/system/dexd.service.d
  if [ -d "$dropin_dir" ] && grep -q -- '--mode' "$dropin_dir"/*.conf 2>/dev/null; then
    echo "dexd: NOTE: $dropin_dir still overrides --mode -- that setting" >&2
    echo "  moved to /opt/dex/exhibit.yaml's display_mode. If the" >&2
    echo "  drop-in's value disagrees with the exhibit config, the unit will" >&2
    echo "  refuse to start (naming both). Remove the drop-in:" >&2
    echo "    sudo rm $dropin_dir/*.conf && sudo systemctl daemon-reload" >&2
  fi
  ;;
esac

#DEBHELPER#

exit 0
